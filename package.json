{
  "name": "@meteo-consensus/web",
  "version": "0.0.0",
  "private": true,
  "description": "Site : landing, démo en direct, documentation de l'API, pages par ville. Consomme l'API publique uniquement.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run audit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "pnpm audit --audit-level high",
    "unused": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "6.44.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
